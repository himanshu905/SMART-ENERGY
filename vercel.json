{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wattwise-api.onrender.com/api/:path*"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/setup",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ]
}
